# AutoInspect AI Configuration
APP_NAME="AutoInspect AI"
APP_VERSION="1.0.0"
DEBUG=False

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=20

# Inference Engine Configuration
# INFERENCE_MODE:
#   - 'auto': Attempts to load weights; falls back to demo/mock if not present
#   - 'mock': Explicit demo/mock mode
#   - 'yolo': Real YOLO segmentation inference (requires trained weights)
INFERENCE_MODE="auto"

# Model Weights File Path (relative to backend/ or absolute path)
YOLO_WEIGHTS_PATH="weights/best.pt"

# Vision Detection Thresholds
CONFIDENCE_THRESHOLD=0.35
UNKNOWN_ANOMALY_THRESHOLD=0.55
IOU_THRESHOLD=0.45

# Persistent inspection history (leave unset for local SQLite development).
# In production, inject this from AWS Secrets Manager / the container runtime.
# URL-encode reserved characters in the database password.
# DATABASE_URL=postgresql+psycopg://autoaudit:REPLACE_ME@your-rds-endpoint:5432/autoaudit?sslmode=require

# Private S3 storage for source, annotated, and heatmap images.
# The API uses the local AWS profile during development or the workload IAM
# role in AWS; never place access keys in this file.
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=your-globally-unique-private-bucket
AWS_S3_PRESIGNED_URL_TTL=3600
