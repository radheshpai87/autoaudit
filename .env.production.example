# =================================================================
# AutoAudit Unified Production Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Backend Inference Engine (FastAPI + YOLOv8 + SQLAlchemy)
# -----------------------------------------------------------------
# Inference mode: "auto" loads real YOLO weights if present, falls back gracefully
INFERENCE_MODE=auto

# Detection confidence and unknown anomaly thresholds
CONFIDENCE_THRESHOLD=0.35
UNKNOWN_ANOMALY_THRESHOLD=0.55

# Relational Database URL (PostgreSQL on AWS RDS or local SQLite fallback)
# Leave blank to automatically use local SQLite storage at $0 cost.
# Example RDS connection:
# DATABASE_URL=postgresql://autoaudit_admin:AutoAuditPass2026!@autoaudit-postgres.czays8gu876z.ap-south-1.rds.amazonaws.com:5432/autoaudit
DATABASE_URL=

# AWS S3 Storage (optional for persistent presigned artifact images)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_S3_PRESIGNED_URL_TTL=3600

# Allowed CORS origins (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------
# 2. WhatsApp Maintenance Microservice (Node.js 20 / Baileys)
# -----------------------------------------------------------------
# Internal listening port
WHATSAPP_PORT=3001

# Shared secret token for authenticating /status and /send-alert requests (Bearer token)
WHATSAPP_SERVICE_TOKEN=autoaudit-secret-whatsapp-token-change-in-prod

# Optional expected sender WhatsApp number (digits only, e.g. 919876543210)
WHATSAPP_EXPECTED_SENDER=

# Optional JSON directory mapping stations to maintenance personnel phone numbers
# WHATSAPP_DIRECTORY_JSON={"ST-01":{"name":"Foundry Lead","phone":"919876543210","station":"ST-01 Casting"}}
WHATSAPP_DIRECTORY_JSON=

# -----------------------------------------------------------------
# 3. Frontend Web Dashboard (Next.js 15)
# -----------------------------------------------------------------
# Internal proxy destination for Next.js server rewrites (/api/py/*)
AUTOINSPECT_API_URL=http://backend:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Client API provider: "http" to query the live backend REST API
NEXT_PUBLIC_AUTOAUDIT_API=http

# Internal WhatsApp service endpoint for Next.js Route Handlers
WHATSAPP_SERVICE_URL=http://whatsapp:3001
