{
  "ServiceName": "autoaudit-whatsapp",
  "SourceConfiguration": {
    "ImageRepository": {
      "ImageIdentifier": "956966433293.dkr.ecr.ap-south-1.amazonaws.com/autoaudit-whatsapp:v1.0.0",
      "ImageConfiguration": {
        "Port": "3001",
        "RuntimeEnvironmentVariables": {
          "NODE_ENV": "production",
          "WHATSAPP_PORT": "3001",
          "WHATSAPP_HOST": "0.0.0.0",
          "WHATSAPP_SERVICE_TOKEN": "autoaudit-secret-whatsapp-token"
        }
      },
      "ImageRepositoryType": "ECR"
    },
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::956966433293:role/AppRunnerECRAccessRole"
    },
    "AutoDeploymentsEnabled": false
  },
  "InstanceConfiguration": {
    "Cpu": "0.25 vCPU",
    "Memory": "0.5 GB"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/status",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  }
}
