# Local FastAPI service. Set the production API origin in the deployment provider.
AUTOINSPECT_API_URL=http://127.0.0.1:8000

# Server-side connection from Next.js to the local WhatsApp service.
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SERVICE_TOKEN=replace-with-the-same-long-random-secret-as-the-service
