# AutoAudit Frontend Environment Variables

# Backend API origin (scheme and host only, no /api suffix)
# Next.js server proxies /api/py/* to this origin.
AUTOINSPECT_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Client API adapter mode: "http" to query backend endpoints, or "mock" for local mock data
NEXT_PUBLIC_AUTOAUDIT_API=http

# WhatsApp microservice URL (server-to-server Next.js Route Handler calls)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001

# Shared secret token for WhatsApp service authentication (Bearer token)
WHATSAPP_SERVICE_TOKEN=autoaudit-secret-whatsapp-token-change-in-prod
